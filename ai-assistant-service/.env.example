# ==============================================================================
# AI Assistant Service - Çevre Değişkenleri Şablonu (.env.example)
# Bu dosyayı '.env' adıyla kopyalayarak yerel ortam değişkenlerinizi ayarlayabilirsiniz.
# UYARI: Gerçek API anahtarlarını ASLA git reposuna commit etmeyin!
# ==============================================================================

# --- Servis Genel Bilgileri ---
# Servisin sistem içindeki adı (Loglama ve Service Registry için kullanılır)
SERVICE_NAME=ai-assistant-service
# Servisin ayağa kalkacağı HTTP port numarası
PORT=8089
# Çalışma ortamı: development (geliştirme), test, production (canlı)
ENVIRONMENT=development
# Detaylı hata ve debug loglarının aktif olup olmaması (True: açık, False: kapalı)
DEBUG=True

# --- Büyük Dil Modeli (LLM) API Anahtarları ---
# OpenAI modelleri için gizli API anahtarı (örn: sk-proj-...)
OPENAI_API_KEY=
# Anthropic Claude modelleri için gizli API anahtarı (örn: sk-ant-...)
ANTHROPIC_API_KEY=
# Google Gemini modelleri için gizli API anahtarı (örn: AIzaSy...)
GEMINI_API_KEY=

# Varsayılan olarak kullanılacak LLM sağlayıcısı ('gemini', 'openai', 'anthropic', 'local')
DEFAULT_LLM_PROVIDER=gemini

# --- Yerel / Self-Hosted LLM (Ollama, vLLM vb.) Ayarları ---
# Yerel LLM çalıştırılıyorsa OpenAI uyumlu sunucu adresi (örn: http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=
# Yerel LLM model adı (örn: llama3:8b, mistral)
LOCAL_LLM_MODEL=

# --- Embedding (Vektörleştirme) Ayarları ---
# Metinleri vektöre dönüştürmek için kullanılacak sağlayıcı ('openai', 'gemini', 'local', 'fake')
EMBEDDING_PROVIDER=openai
# Kullanılacak embedding modelinin tam adı (örn: text-embedding-3-small, text-embedding-004, BAAI/bge-m3)
EMBEDDING_MODEL=text-embedding-3-small
# Vektör boyutu kısaltma (Matryoshka Representation Learning için; boş bırakılırsa modelin doğal boyutu kullanılır, örn: 1536 veya 512)
EMBEDDING_DIMENSIONS=

# --- Qdrant Vektör Veritabanı Ayarları ---
# Qdrant sunucusunun REST API erişim adresi (Yerel Docker ortamında varsayılan: http://localhost:6333)
QDRANT_URL=http://localhost:6333
# Qdrant Cloud veya şifreli bağlantı kullanılıyorsa API anahtarı (Yerel Docker'da boş bırakılır)
QDRANT_API_KEY=
# Koleksiyon isimlerinin başına eklenecek ortak önek (örn: commerce_docs -> commerce_docs__openai_text_embedding_3_small_1536)
QDRANT_COLLECTION_PREFIX=commerce_docs

# --- RAG Cevap Üretimi (Generation) Ayarları ---
# Generation için özel LLM sağlayıcısı (boş bırakılırsa DEFAULT_LLM_PROVIDER kullanılır: 'gemini', 'openai', 'anthropic', 'local')
RAG_LLM_PROVIDER=
# Generation için özel model adı (boş bırakılırsa sağlayıcının varsayılanı kullanılır)
RAG_LLM_MODEL=
# Yanıt üretiminde deterministiklik ve tekrarlanabilirlik için sıcaklık (0.0 önerilir)
RAG_TEMPERATURE=0.0
# Modelin üretebileceği maksimum token uzunluğu
RAG_MAX_OUTPUT_TOKENS=400
# LLM çağrısının zaman aşımı süresi (saniye)
RAG_LLM_TIMEOUT_SEC=30.0
# Prompt context'ine dahil edilecek maksimum token bütçesi
RAG_CONTEXT_TOKEN_BUDGET=1500
# Qdrant'tan getirilecek aday chunk sayısı
RAG_TOP_K=5
# Minimum dense cosine benzerlik eşiği (bu eşiğin altındaki sorgular modele gitmeden abstain edilir; None ise kapalı)
RAG_MIN_DENSE_SCORE=
# Doğrulama hatalarında maksimum LLM tekrar deneme sayısı
RAG_MAX_ATTEMPTS=2
# Bilgi bulunamadığında kullanıcıya gösterilecek kurumsal yanıt mesajı
RAG_ABSTAIN_MESSAGE="Bu konuda dokümanlarımızda bilgi bulamadım. Sizi bir müşteri temsilcisine yönlendirebilirim."
# Arama modu ('hybrid', 'dense', 'sparse')
RAG_RETRIEVAL_MODE=hybrid

# --- Reranker Ayarları ---
# Reranker'ın aktif olup olmaması (True: açık, False: kapalı - varsayılan: False)
RAG_RERANK_ENABLED=False
# Reranker sağlayıcısı ('cross_encoder', 'cohere', 'fake')
RAG_RERANK_PROVIDER=cross_encoder
# Özel model adı (boş bırakılırsa sağlayıcının varsayılanı kullanılır)
RAG_RERANK_MODEL=
# Retrieval'dan reranker'a iletilecek aday chunk sayısı (1-50 arası, varsayılan: 20)
RAG_RERANK_CANDIDATES=20
# Reranker çağrısının zaman aşımı süresi (saniye, varsayılan: 10.0)
RAG_RERANK_TIMEOUT_SEC=10.0
# Reranker hata verirse orijinal retrieval sırasıyla devam edilsin mi (True: fail-open, False: fail-closed)
RAG_RERANK_FAIL_OPEN=True
# Cohere reranker kullanılacaksa API anahtarı
COHERE_API_KEY=

# --- Ağ Geçidi (Gateway) Güvenlik Ayarları ---
# Servisler arası doğrudan çağrıları engellemek için API Gateway ile paylaşılan gizli belirteç
GATEWAY_INTERNAL_SECRET=dgl-internal-gateway-secret-token-2026
# Ağ geçidi gizli anahtar kontrolünün devrede olup olmaması (Yerel testlerde False yapılabilir)
GATEWAY_SECURITY_ENABLED=True

# --- Downstream Mikroservis Bağlantıları ---
# Sipariş servisi (order-service) temel erişim adresi
ORDER_SERVICE_URL=http://localhost:8082
# Kargo servisi (shipping-service) temel erişim adresi
SHIPPING_SERVICE_URL=http://localhost:8085
# Downstream servis HTTP istekleri için zaman aşımı süresi (saniye cinsinden)
DOWNSTREAM_TIMEOUT_SEC=5.0

# --- Müşteri Destek Ajanı (Agent) Ayarları ---
# Agent için özel LLM sağlayıcısı (boş bırakılırsa DEFAULT_LLM_PROVIDER kullanılır: 'gemini', 'openai', 'anthropic', 'local')
AGENT_LLM_PROVIDER=
# Agent için özel model adı (boş bırakılırsa seçilen sağlayıcının varsayılan modeli kullanılır)
AGENT_LLM_MODEL=
# Yanıt üretiminde deterministiklik için sıcaklık (0.0 önerilir)
AGENT_TEMPERATURE=0.0
# Ajanın tek bir adımda üretebileceği maksimum token uzunluğu
AGENT_MAX_OUTPUT_TOKENS=500
# LLM çağrısının maksimum zaman aşımı süresi (saniye)
AGENT_LLM_TIMEOUT_SEC=30.0
# Araç (tool) çağrılarının maksimum zaman aşımı süresi (saniye)
AGENT_TOOL_TIMEOUT_SEC=8.0
# Ajanın bir kullanıcı sorusu için gerçekleştirebileceği maksimum döngü (step) sayısı
AGENT_MAX_STEPS=4
# Prompt context şişmesini önlemek için bir aracın döndürebileceği maksimum karakter uzunluğu
AGENT_MAX_TOOL_RESULT_CHARS=2000
# Onay bekleyen aksiyonların (sipariş iptali vb.) geçerlilik süresi (saniye cinsinden, varsayılan 300 sn = 5 dk)
AGENT_PENDING_TTL_SEC=300
# Ajan isteği güvenle tamamlayamadığında veya adım limiti aşıldığında dönülecek güvenli mesaj
AGENT_FALLBACK_MESSAGE="Şu an bu isteğinizi güvenle tamamlayamadım. Sizi bir müşteri temsilcisine yönlendirebilirim."

# --- Destek Talebi ve Olay Mesajlaşması ---
# Destek talebi yayıncı türü ('log' veya 'kafka')
TICKET_PUBLISHER=log
# Kafka broker adresleri (yalnızca TICKET_PUBLISHER=kafka ise kullanılır)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Destek taleplerinin yayınlanacağı Kafka konu (topic) adı
SUPPORT_TICKET_TOPIC=support.ticket.created

