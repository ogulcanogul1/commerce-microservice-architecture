# Service Configuration
SERVICE_NAME=ai-assistant-service
SERVICE_HOST=localhost
SERVICE_PORT=8089
ENVIRONMENT=dev

# Eureka Service Discovery
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Gateway & Downstream Services Security
GATEWAY_SECRET_ENABLED=true
GATEWAY_INTERNAL_SECRET=dgl-internal-gateway-secret-token-2026
GATEWAY_BASE_URL=http://localhost:8080
ORDER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8081
SHIPPING_SERVICE_URL=http://localhost:8085
INVENTORY_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8083

# Redis Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
SESSION_TTL_SECONDS=1800

# Apache Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SUPPORT_TOPIC=support.ticket.created

# OpenTelemetry Distributed Tracing
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# LLM Providers Configuration (claude | openai | gemini | local)
DEFAULT_LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
