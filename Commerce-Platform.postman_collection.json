              "path": ["api", "v1", "inventory", "SKU-PHONE-PRO-01"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Order & Saga Orchestration",
      "item": [
        {
          "name": "Create Order (Trigger Saga)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('orderId', data.id);",
                  "pm.collectionVariables.set('orderNumber', data.orderNumber);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
