              "raw": "{\n  \"customerId\": \"00000000-0000-0000-0000-000000000000\",\n  \"shippingAddress\": \"Unauthenticated\",\n  \"currency\": \"TRY\",\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
