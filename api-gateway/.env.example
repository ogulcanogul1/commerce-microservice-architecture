# ==============================================================================
# api-gateway - Ortam Değişkenleri Şablonu (.env.example)
#
# Config Server'daki yaml'larda değerin kendisi değil placeholder durur:
#   password: ${SPRING_DATASOURCE_PASSWORD:postgres}
# Bu placeholder'ı servis KENDİ ortam değişkenlerinden çözer. Değerler buradadır.
#
# DİKKAT: Spring Boot .env dosyasını kendiliğinden OKUMAZ. Docker'da değerler
# docker-compose.apps.yml 'environment:' bloğundan gelir. Yerel çalıştırmada
# bu dosyayı IDE'nin EnvFile/Run Configuration ayarıyla yükleyin.
# Kullanım: bu dosyayı '.env' adıyla kopyalayın; secret'ları kendi değerlerinizle değiştirin.
# ==============================================================================

# --- Profil ve Platform ---
SPRING_PROFILES_ACTIVE=dev
CONFIG_SERVER_URL=http://localhost:8888/
EUREKA_CLIENT_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Secret'lar ---
# Gateway -> servis iç çağrı doğrulaması (common/application.yaml: gateway.internal.secret)
GATEWAY_INTERNAL_SECRET=change-me-gateway-internal-secret
# JWT imzalama anahtarı (en az 32 karakter)
JWT_SECRET=change-me-jwt-signing-key-at-least-32-characters

# --- Rota hedefleri (varsayılan: Eureka üzerinden lb://) ---
# SERVICES_PRODUCT_URL=lb://product-service
# SERVICES_ORDER_URL=lb://order-service
# SERVICES_PAYMENT_URL=lb://payment-service
# SERVICES_INVENTORY_URL=lb://inventory-service
# SERVICES_SHIPPING_URL=lb://shipping-service
# SERVICES_CUSTOMER_URL=lb://customer-service
# SERVICES_NOTIFICATION_URL=lb://notification-service
# SERVICES_AI_ASSISTANT_URL=lb://ai-assistant-service
